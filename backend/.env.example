# ── Обязательный ключ ────────────────────────────────────────────────
GEMINI_API_KEY=вставьте_сюда_ваш_реальный_ключ_из_AI_Studio

# ── Параметры моделей и отказоустойчивости ────────────────────────────
# Основная актуальная модель (Gemini 3.8 Flash)
GEMINI_MODEL=gemini-3.8-flash

# Список резервных моделей (fallback при 503/404/429)
GEMINI_FALLBACK_MODELS=["gemini-3.6-flash"]

# Количество попыток перед переключением на резервную модель
GEMINI_MAX_RETRIES=3

# Базовая задержка между попытками в секундах
GEMINI_RETRY_DELAY=2.0

# ── Ограничения на загрузку изображений ──────────────────────────────
MAX_FILE_SIZE_MB=8
MAX_IMAGE_DIMENSION=2000

# ── CORS ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]